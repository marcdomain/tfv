  },
  "files": [
    "index.js",
    "lib/"
  ],
  "workspaces": [
    "packages/*"
  ],
  "author": "Marcus Chukwuoma <marcus2cu@gmail.com> (https://github.com/marcdomain)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcdomain/teriac.git"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "yargs": "^17.2.1"
  },
