    "opentofu",
    "terragrunt",
    "version-manager",
    "tfenv",
    "tofuenv",
    "tgenv",
    "iac",
    "devops",
    "cli"
  ],
  "homepage": "https://teriac.marcdomain.dev",
  "bugs": {
    "url": "https://github.com/marcdomain/teriac/issues"
  },
  "main": "index.js",
  "scripts": {
    "test": "jest --testPathPatterns=test/"
  },
  "bin": {
